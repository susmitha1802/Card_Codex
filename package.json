{
  "name": "emotale",
  "description": "Emotale — Little messages. Lasting feelings.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "brand:assets": "node server/scripts/build-brand-assets.js",
    "test": "npm run test --workspace server",
    "test:db": "npm run test:db --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:check": "npm run db:check --workspace server",
    "db:import:mysql": "npm run db:import:mysql --workspace server --",
    "db:import:referenced": "npm run db:import:referenced --workspace server --"
  },
  "devDependencies": { "concurrently": "^10.0.5" }
}

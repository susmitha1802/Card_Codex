# Emotale — Little messages. Lasting feelings.
# TEMPLATE ONLY: no real secrets. Supply values through your host's secret manager
# or an uncommitted server/.env. Do not overwrite your development .env blindly.
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
# Actual public HTTPS origin shared by frontend/API/cards/metadata; no path.
PUBLIC_APP_ORIGIN=https://emotale.example
# Only your controlled proxy's network addresses; the proxy must overwrite XFF.
TRUST_PROXY=127.0.0.1/32

# Create an Atlas cluster, restrict its IP access list, and use a restricted
# runtime database user. Store this URI only in the server secret manager.
MONGODB_URI=mongodb+srv://your-runtime-user:URL_ENCODED_PASSWORD@your-cluster.example.mongodb.net/?retryWrites=true&w=majority
# Retained technical database name; branding does not move existing data.
MONGODB_DB_NAME=card_codex
MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=0
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=1000
MONGODB_QUEUE_LIMIT=10
MONGODB_OPERATION_TIMEOUT_MS=3000
MONGODB_MAX_IDLE_TIME_MS=60000

# One-time import and disposable-test settings are documented in DEPLOYMENT.md.
# They are disabled by default and are not needed in runtime configuration.

# No object provider has been selected/implemented. The default below blocks
# production startup until you explicitly acknowledge private persistent local
# storage. Set true plus an absolute durable path ONLY after provisioning it.
# Linux example: /var/lib/emotale/photos; Windows: D:/EmotalePrivatePhotos.
MEDIA_DRIVER=local
MEDIA_DIRECTORY=
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

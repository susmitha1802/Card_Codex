# Emotale — Little messages. Lasting feelings.
# TEMPLATE ONLY. Copy to server/.env only if that file does not already exist.
# Both Express and Vite use server/.env. No client/.env is needed.

# ADD YOUR ATLAS CONNECTION STRING HERE in server/.env, never in client code.
# Replace the local URI below with your Atlas URI. URL-encode special characters
# in its username/password. Keep server/.env private and out of Git.
MONGODB_URI=mongodb://127.0.0.1:27017
# Keep this name unless you intentionally want a different database.
MONGODB_DB_NAME=card_codex

# Local development uses Vite. Production settings are in DEPLOYMENT.md.
NODE_ENV=development
# Backend address. Vite automatically forwards /api to HOST and PORT.
HOST=127.0.0.1
PORT=3001
# Frontend address used for link-preview URLs: origin only, without a path.
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173

# Optional absolute private photo folder; blank uses server/storage/photos.
# Existing photo files must stay at their configured location.
MEDIA_DIRECTORY=

# All other settings have safe development defaults in config-reader.js.
# Pool/timeouts, production, importer guards, and disposable database tests:
# see DEPLOYMENT.md. Import/test opt-ins default to disabled when omitted.
# API_PROXY_TARGET is an optional server-side override for a nonlocal API;
# normal local development does not need it. Restart npm run dev after edits.
